NODE_ENV="development"

# Credenciais OAuth do Google Cloud; veja o README
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Registre exatamente este endereço nas credenciais do Google Cloud.
REDIRECT_URI="http://127.0.0.1:4200/api/youtube/callback"

# Chave de 32 bytes em hexadecimal usada para criptografar os tokens no banco. Para gerar:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

PG_USER="postgres"
PG_PASSWORD="password"
PG_HOST="127.0.0.1"
PG_PORT="5432"
PG_DATABASE="appspot"
PG_DATABASE_TEST="appspot-test"
