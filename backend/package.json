{
  "name": "jukebox-api",
  "version": "1.0.0",
  "description": "API da jukebox colaborativa",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "knex migrate:latest",
    "knex": "knex",
    "test": "cross-env NODE_ENV=test node scripts/ensure-test-db.js && cross-env NODE_ENV=test knex migrate:latest && cross-env NODE_ENV=test node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "author": "Stenio L. de Souza",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
